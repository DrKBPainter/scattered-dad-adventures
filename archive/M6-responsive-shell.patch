+  body.m-compact #log.log-play.log-open{position:absolute;left:0;right:0;bottom:0;height:auto;max-height:55vh;overflow-y:auto;display:block;z-index:70;margin:0;background:var(--panel);border-top:2px solid var(--gold);padding:6px 46px 6px 8px;box-shadow:0 -8px 24px rgba(0,0,0,.75);}
+  body.m-compact #log.log-play.log-open::after{content:"\25BE close";top:6px;bottom:auto;right:6px;}
+  body.m-compact #hud.log-open-host{padding-bottom:39px;}
+  body.m-compact #dpad{margin:0 auto;}
+  body.m-compact #actionbar{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;overflow-y:hidden;width:100%;max-width:100%;gap:4px;margin:0;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
+  body.m-compact #actionbar::-webkit-scrollbar{display:none;}
+  body.m-compact #actionbar button{flex:0 0 auto;min-height:40px;padding:6px 10px;font-size:11px;}
+  body.m-compact #aimbar{margin:0 auto;} body.m-compact #aimbar button{min-height:40px;}
